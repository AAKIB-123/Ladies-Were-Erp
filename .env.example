# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# Local MongoDB or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/ladies_wear_db

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d

# Initial Admin Bootstrap (Used only by the bootstrap script: npm run seed:admin)
INITIAL_ADMIN_NAME=Store Owner
INITIAL_ADMIN_EMAIL=owner@ladieswear.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_set_a_unique_strong_password

# Initial Staff Bootstrap
INITIAL_STAFF_NAME=Staff Member
INITIAL_STAFF_EMAIL=staff@example.com
INITIAL_STAFF_PASSWORD=CHANGE_ME_set_a_unique_strong_password
